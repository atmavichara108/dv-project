filters:
  and:
    - type == "task"
    - status != "done"
    - status != "parked"
formulas:
  age_days: (now() - file.ctime) / (1000 * 60 * 60 * 24)
  prio_emoji: if(priority == "P0", "🔥", if(priority == "P1", "⭐", if(priority == "P2", "•", "·")))
properties:
  note.id:
    displayName: ID
  note.title:
    displayName: Задача
  note.status:
    displayName: Статус
  note.priority:
    displayName: Приоритет
  note.epic:
    displayName: Эпик
  note.effort:
    displayName: Объём
  note.sprint:
    displayName: Спринт
  formula.age_days:
    displayName: Дней в работе
views:
  - type: kanban-view
    name: Канбан
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.prio_emoji
      - title
      - epic
      - effort
    columnOrders:
      file.file:
        - DV/Operations/Kanban/DV-001 Создать product-vision и архитектурные документы.md
        - DV/Operations/Kanban/DV-002 Подключить dv-project как git submodule.md
        - DV/Operations/Kanban/DV-003 Настроить opencode.json.md
      note.status:
        - backlog
    cardOrders:
      file.file:
        DV/Operations/Kanban/DV-002 Подключить dv-project как git submodule.md: []
        DV/Operations/Kanban/DV-003 Настроить opencode.json.md:
          - DV/Operations/Kanban/DV-002 Подключить dv-project как git submodule.md
          - DV/Operations/Kanban/DV-003 Настроить opencode.json.md
      note.status: {}
    columnColors:
      file.file:
        DV/Operations/Kanban/DV-001 Создать product-vision и архитектурные документы.md: purple
      note.status: {}
    groupByProperty: note.status
  - type: table
    name: Все задачи
    order:
      - id
      - title
      - status
      - priority
      - epic
      - effort
      - sprint
  - type: cards
    name: По эпикам
    groupBy:
      property: epic
      direction: ASC
    order:
      - title
      - status
      - priority
